{
  "id": "bookmark-folder-appearance",
  "title": "Bookmark folder appearance",
  "description": "Give bookmark folders colors and icons, from a right-click menu like the tab group one.",
  "tested": ["1.0.1022.1"],
  "options": [
    {"group": "Indicator", "key": "indicator.show", "type": "switch", "title": "Show", "default": true},
    {"group": "Indicator", "key": "indicator.position", "type": "select", "title": "Position", "when": "indicator.show", "default": "right", "choices": [{"value": "right", "title": "Aligned right"}, {"value": "before-icon", "title": "Before icon"}, {"value": "before-name", "title": "Before name"}, {"value": "after-name", "title": "After name"}]},
    {"group": "Indicator", "key": "indicator.closed", "type": "select", "title": "When closed", "when": "indicator.show", "default": "down", "choices": [{"value": "down", "title": "Down"}, {"value": "left", "title": "Left"}, {"value": "up", "title": "Up"}, {"value": "right", "title": "Right"}]},
    {"group": "Indicator", "key": "indicator.open", "type": "select", "title": "When open", "when": "indicator.show", "default": "up", "choices": [{"value": "down", "title": "Down"}, {"value": "left", "title": "Left"}, {"value": "up", "title": "Up"}, {"value": "right", "title": "Right"}]},
    {"group": "Indicator", "key": "indicator.flip", "type": "switch", "title": "Flip animation direction", "when": "indicator.show", "default": false},
    {"group": "Nesting", "key": "nesting.left", "type": "slider", "title": "Offset left", "default": 14, "min": 0, "max": 32, "unit": "px"},
    {"group": "Nesting", "key": "nesting.right", "type": "slider", "title": "Offset right", "default": 6, "min": 0, "max": 32, "unit": "px"},
    {"group": "Nesting", "key": "nesting.bottom", "type": "slider", "title": "Offset bottom", "default": 4, "min": 0, "max": 24, "unit": "px"},
    {"group": "Nesting", "key": "nesting.loaded", "type": "switch", "title": "Collapsed loaded nesting", "default": false},
    {"group": "Nesting", "key": "nesting.active-first", "type": "switch", "title": "Selected tab first when collapsed", "default": false},
    {"group": "Backdrop", "key": "backdrop.show", "type": "switch", "title": "Show", "default": true},
    {"group": "Backdrop", "key": "backdrop.tinted", "type": "switch", "title": "Tinted", "when": "backdrop.show", "default": true},
    {"group": "Backdrop", "key": "backdrop.hover", "type": "select", "title": "Highlight folders on hover", "default": "false", "choices": [{"value": "false", "title": "Never"}, {"value": "collapsed", "title": "When collapsed"}, {"value": "true", "title": "Always"}]},
    {"group": "Bookmarks", "key": "bookmark.remove", "type": "switch", "title": "X removes unloaded bookmarks", "default": false},
    {"group": "Bookmarks", "key": "bookmark.confirm", "type": "switch", "title": "Ask before removing", "when": "bookmark.remove", "default": true},
    {"group": "Bookmarks", "key": "bookmark.minus", "type": "switch", "title": "Minus instead of X when loaded", "default": false},
    {"group": "Bookmarks", "key": "bookmark.unload-folder", "type": "select", "title": "Button to unload a folder's tabs", "default": "never", "choices": [{"value": "never", "title": "Never"}, {"value": "collapsed", "title": "When collapsed"}, {"value": "always", "title": "Always"}]},
    {"group": "Bookmarks", "key": "bookmark.unload-animated", "type": "switch", "title": "Animate unloading from a collapsed folder", "default": true}
  ]
}
